  "text": "This can make your teeth sensitive,",
  "voice": "NARRATOR",
  "motion": "pan",
  "scene": "mouth",
  "image": "images/beat_022.png"
 },
 {
  "beat": 23,
  "start": 75.419,
  "dur": 3.333,
