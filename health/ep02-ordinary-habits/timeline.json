  "voice": "NARRATOR",
  "motion": "push",
  "scene": "bathroom",
  "image": "images/beat_026.png"
 },
 {
  "beat": 27,
  "start": 90.419,
  "dur": 1.667,
  "text": "Use a soft-bristled toothbrush,",
  "voice": "NARRATOR",
  "motion": "pan",
  "scene": "bathroom",
  "image": "images/beat_027.png"
 },
 {
  "beat": 28,
  "start": 92.086,
  "dur": 1.25,
  "text": "hold it gently,",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "bathroom",
  "image": "images/beat_028.png"
 },
 {
  "beat": 29,
  "start": 93.336,
  "dur": 3.333,
  "text": "and clean your teeth with small, controlled movements.",
  "voice": "NARRATOR",
  "motion": "pull",
  "scene": "mouth",
  "image": "images/beat_029.png"
 },
 {
  "beat": 30,
  "start": 96.669,
  "dur": 2.917,
  "text": "And if you use an electric toothbrush,",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "bathroom",
  "image": "images/beat_030.png"
 },
 {
  "beat": 31,
  "start": 99.586,
  "dur": 4.167,
  "text": "some models even warn you when you're pressing too hard.",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "bathroom",
  "image": "images/beat_031.png"
 },
 {
  "beat": 32,
  "start": 103.753,
  "dur": 1.25,
  "text": "Simple enough, right?",
  "voice": "NARRATOR",
  "motion": "pan",
  "scene": "bathroom",
  "image": "images/beat_032.png"
 },
 {
  "beat": 33,
  "start": 105.003,
  "dur": 2.083,
  "text": "But now you're running late.",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "bathroom",
  "image": "images/beat_033.png"
 },
 {
  "beat": 34,
  "start": 107.086,
  "dur": 5.417,
  "text": "You have places to be, things to do, and you need to eat.",
  "voice": "NARRATOR",
  "motion": "pull",
  "scene": "kitchen",
  "image": "images/beat_034.png"
 },
 {
  "beat": 35,
  "start": 112.503,
  "dur": 2.5,
  "text": "Which brings us to another habit.",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "kitchen",
  "image": "images/beat_035.png"
 },
 {
  "beat": 36,
  "start": 115.003,
  "dur": 3.333,
  "text": "Have you ever finished a meal so quickly",
  "voice": "NARRATOR",
  "motion": "fade",
  "scene": "kitchen",
  "image": "images/beat_036.png"
 },
 {
  "beat": 37,
  "start": 118.336,
  "dur": 2.5,
  "text": "that you barely remember eating it?",
  "voice": "NARRATOR",
  "motion": "pan",
  "scene": "kitchen",
  "image": "images/beat_037.png"
 },
 {
  "beat": 38,
  "start": 120.836,
  "dur": 3.333,
  "text": "Maybe you're rushing to get back to work.",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "office",
  "image": "images/beat_038.png"
 },
 {
  "beat": 39,
  "start": 124.169,
  "dur": 2.5,
  "text": "Maybe you're distracted by your phone.",
  "voice": "NARRATOR",
  "motion": "pull",
  "scene": "kitchen",
  "image": "images/beat_039.png"
 },
 {
  "beat": 40,
  "start": 126.669,
  "dur": 2.917,
  "text": "Or maybe you're just really, really hungry.",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "kitchen",
  "image": "images/beat_040.png"
 },
 {
  "beat": 41,
  "start": 129.586,
  "dur": 2.5,
  "text": "Whatever the reason, you start eating.",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "kitchen",
  "image": "images/beat_041.png"
 },
 {
  "beat": 42,
  "start": 132.086,
  "dur": 2.5,
  "text": "One bite, then another, and another.",
