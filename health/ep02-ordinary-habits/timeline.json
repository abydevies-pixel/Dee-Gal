  "motion": "pan",
  "scene": "kitchen",
  "image": "images/beat_042.png"
 },
 {
  "beat": 43,
  "start": 134.586,
  "dur": 3.333,
  "text": "Before you know it, the plate is empty.",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "kitchen",
  "image": "images/beat_043.png"
 },
 {
  "beat": 44,
  "start": 137.919,
  "dur": 3.333,
  "text": "Congratulations! You've just set a new personal record.",
  "voice": "NARRATOR",
  "motion": "shake",
  "scene": "kitchen",
  "image": "images/beat_044.png"
 },
 {
  "beat": 45,
  "start": 141.252,
  "dur": 4.583,
  "text": "But there is more to the race than what we see.",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "kitchen",
  "image": "images/beat_045.png"
 },
 {
  "beat": 46,
  "start": 145.835,
  "dur": 4.167,
  "text": "As you eat, your stomach sends messages to your brain",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "body",
  "image": "images/beat_046.png"
 },
 {
  "beat": 47,
  "start": 150.002,
  "dur": 2.5,
  "text": "telling it how full you're getting.",
  "voice": "NARRATOR",
  "motion": "pan",
  "scene": "body",
  "image": "images/beat_047.png"
 },
 {
  "beat": 48,
  "start": 152.502,
  "dur": 2.917,
  "text": "But those messages take time to arrive.",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "body",
  "image": "images/beat_048.png"
 },
 {
  "beat": 49,
  "start": 155.419,
  "dur": 4.167,
  "text": "So when you eat too quickly, you might keep eating",
