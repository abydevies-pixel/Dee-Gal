[
 {
  "beat": 1,
  "start": 0.0,
  "dur": 3.75,
  "text": "It's lunchtime and you just had a wonderful meal.",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "cafe",
  "image": "images/beat_001.png"
 },
 {
  "beat": 2,
  "start": 3.75,
  "dur": 3.333,
  "text": "You're full, satisfied, and life feels great again.",
  "voice": "NARRATOR",
  "motion": "pan",
  "scene": "cafe",
  "image": "images/beat_002.png"
 },
 {
  "beat": 3,
  "start": 7.083,
  "dur": 2.917,
  "text": "It's time to get back to work.",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "office",
  "image": "images/beat_003.png"
 },
 {
  "beat": 4,
  "start": 10.0,
  "dur": 1.2,
  "text": "Except...",
  "voice": "NARRATOR",
  "motion": "pull",
  "scene": "office",
  "image": "images/beat_004.png"
 },
 {
  "beat": 5,
  "start": 11.2,
  "dur": 1.667,
  "text": "Your eyes are closing.",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "office",
  "image": "images/beat_005.png"
 },
 {
  "beat": 6,
  "start": 12.867,
  "dur": 4.167,
  "text": "You try to concentrate, but your brain is not cooperating.",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "office",
  "image": "images/beat_006.png"
 },
 {
  "beat": 7,
  "start": 17.034,
  "dur": 2.917,
  "text": "You read the same sentence three times,",
  "voice": "NARRATOR",
  "motion": "pan",
  "scene": "office",
  "image": "images/beat_007.png"
 },
 {
  "beat": 8,
  "start": 19.951,
  "dur": 4.167,
  "text": "and somehow, you still have no idea what it says.",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "office",
  "image": "images/beat_008.png"
 },
 {
  "beat": 9,
  "start": 24.118,
  "dur": 1.667,
  "text": "But wait a minute…",
  "voice": "NARRATOR",
  "motion": "pull",
  "scene": "office",
  "image": "images/beat_009.png"
 },
 {
  "beat": 10,
  "start": 25.785,
  "dur": 2.5,
  "text": "You were perfectly fine before eating.",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "office",
  "image": "images/beat_010.png"
 },
 {
  "beat": 11,
  "start": 28.285,
  "dur": 4.583,
  "text": "In fact, you ate because you were hungry and needed energy.",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "cafe",
  "image": "images/beat_011.png"
 },
 {
  "beat": 12,
  "start": 32.868,
  "dur": 3.75,
  "text": "So why is your body suddenly behaving like someone",
  "voice": "NARRATOR",
  "motion": "pan",
  "scene": "office",
  "image": "images/beat_012.png"
 },
 {
  "beat": 13,
  "start": 36.618,
  "dur": 2.917,
  "text": "slipped a sleeping pill into your food?",
  "voice": "NARRATOR",
  "motion": "shake",
  "scene": "cafe",
  "image": "images/beat_013.png"
 },
 {
  "beat": 14,
  "start": 39.535,
  "dur": 2.083,
  "text": "First, you're not imagining it.",
  "voice": "NARRATOR",
  "motion": "pull",
  "scene": "office",
  "image": "images/beat_014.png"
 },
 {
  "beat": 15,
  "start": 41.618,
  "dur": 2.917,
  "text": "That sleepy feeling has a medical name.",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "graphic",
  "image": "images/beat_015.png"
 },
 {
  "beat": 16,
  "start": 44.535,
  "dur": 1.2,
  "text": "Postprandial somnolence.",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "graphic",
  "image": "images/beat_016.png"
 },
 {
  "beat": 17,
  "start": 45.735,
  "dur": 2.5,
  "text": "Which simply means sleepiness after eating.",
  "voice": "NARRATOR",
  "motion": "pan",
  "scene": "graphic",
  "image": "images/beat_017.png"
 },
 {
  "beat": 18,
  "start": 48.235,
  "dur": 5.0,
  "text": "Most people call it a food coma, so let's go with that.",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "office",
  "image": "images/beat_018.png"
 },
 {
  "beat": 19,
  "start": 53.235,
  "dur": 3.333,
  "text": "And no, you're not actually in a coma.",
  "voice": "NARRATOR",
  "motion": "pull",
  "scene": "office",
  "image": "images/beat_019.png"
 },
 {
  "beat": 20,
  "start": 56.568,
  "dur": 3.75,
  "text": "You're still conscious. Just sleepy and struggling to concentrate.",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "office",
  "image": "images/beat_020.png"
 },
 {
  "beat": 21,
  "start": 60.318,
  "dur": 3.333,
  "text": "It's actually a very common response after eating.",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "office",
  "image": "images/beat_021.png"
 },
 {
  "beat": 22,
  "start": 63.651,
  "dur": 5.0,
  "text": "For years, people have offered some simple explanations for why this happens.",
  "voice": "NARRATOR",
  "motion": "pan",
  "scene": "office",
  "image": "images/beat_022.png"
 },
 {
  "beat": 23,
  "start": 68.651,
  "dur": 2.917,
  "text": "Some say that after eating, blood rushes",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "body",
  "image": "images/beat_023.png"
 },
 {
  "beat": 24,
  "start": 71.568,
  "dur": 4.167,
  "text": "from your brain to your stomach to help with digestion.",
  "voice": "NARRATOR",
  "motion": "pull",
  "scene": "body",
  "image": "images/beat_024.png"
 },
 {
  "beat": 25,
  "start": 75.735,
  "dur": 3.75,
  "text": "So your brain doesn't get enough blood or oxygen,",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "body",
  "image": "images/beat_025.png"
 },
 {
  "beat": 26,
  "start": 79.485,
  "dur": 2.5,
  "text": "and that's why you feel sleepy.",
  "voice": "NARRATOR",
  "motion": "shake",
  "scene": "office",
  "image": "images/beat_026.png"
 },
 {
  "beat": 27,
  "start": 81.985,
  "dur": 1.25,
  "text": "Heard that before?",
  "voice": "NARRATOR",
  "motion": "pan",
  "scene": "office",
  "image": "images/beat_027.png"
 },
 {
  "beat": 28,
  "start": 83.235,
  "dur": 4.583,
  "text": "Others say that the sleepiness is caused by your blood sugar",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "graphic",
  "image": "images/beat_028.png"
 },
 {
  "beat": 29,
  "start": 87.818,
  "dur": 2.083,
  "text": "suddenly crashing after a meal.",
  "voice": "NARRATOR",
  "motion": "pull",
  "scene": "graphic",
  "image": "images/beat_029.png"
 },
 {
  "beat": 30,
  "start": 89.901,
  "dur": 3.75,
  "text": "But neither of these explains the usual food coma.",
  "voice": "NARRATOR",
  "motion": "shake",
  "scene": "graphic",
  "image": "images/beat_030.png"
 },
 {
  "beat": 31,
  "start": 93.651,
  "dur": 4.167,
  "text": "Yes, blood flow to your digestive organs increases after eating.",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "body",
  "image": "images/beat_031.png"
 },
 {
  "beat": 32,
  "start": 97.818,
  "dur": 5.0,
  "text": "But your body doesn't simply abandon your brain to make that happen.",
  "voice": "NARRATOR",
  "motion": "pan",
  "scene": "body",
  "image": "images/beat_032.png"
 },
 {
  "beat": 33,
  "start": 102.818,
  "dur": 3.75,
  "text": "So no, your stomach hasn't stolen your brain's oxygen",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "body",
  "image": "images/beat_033.png"
 },
 {
  "beat": 34,
  "start": 106.568,
  "dur": 2.5,
  "text": "because you ate too much rice.",
  "voice": "NARRATOR",
  "motion": "pull",
  "scene": "cafe",
  "image": "images/beat_034.png"
 },
 {
  "beat": 35,
  "start": 109.068,
  "dur": 2.917,
  "text": "And what about that blood sugar crash?",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "graphic",
  "image": "images/beat_035.png"
 },
 {
  "beat": 36,
  "start": 111.985,
  "dur": 4.583,
  "text": "Well, after eating carbohydrates, your body breaks them down into glucose,",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "body",
  "image": "images/beat_036.png"
 },
 {
  "beat": 37,
  "start": 116.568,
  "dur": 2.5,
  "text": "causing your blood sugar to rise.",
  "voice": "NARRATOR",
  "motion": "pan",
  "scene": "blood",
  "image": "images/beat_037.png"
 },
 {
  "beat": 38,
  "start": 119.068,
  "dur": 2.083,
  "text": "Your pancreas then releases insulin",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "body",
  "image": "images/beat_038.png"
 },
 {
  "beat": 39,
  "start": 121.151,
  "dur": 3.333,
  "text": "to help move that glucose into your cells,",
  "voice": "NARRATOR",
  "motion": "pull",
  "scene": "blood",
  "image": "images/beat_039.png"
 },
 {
  "beat": 40,
  "start": 124.484,
  "dur": 2.917,
  "text": "where it can be used for energy.",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "blood",
  "image": "images/beat_040.png"
 },
 {
  "beat": 41,
  "start": 127.401,
  "dur": 3.75,
  "text": "In most healthy people, this process is carefully regulated.",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "graphic",
  "image": "images/beat_041.png"
 },
 {
  "beat": 42,
  "start": 131.151,
  "dur": 3.75,
  "text": "There is a real condition though called reactive hypoglycemia,",
  "voice": "NARRATOR",
  "motion": "pan",
  "scene": "graphic",
  "image": "images/beat_042.png"
 },
 {
  "beat": 43,
  "start": 134.901,
  "dur": 3.333,
  "text": "where blood sugar falls too low after eating.",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "graphic",
  "image": "images/beat_043.png"
 },
 {
  "beat": 44,
  "start": 138.234,
  "dur": 3.333,
  "text": "But this is different from ordinary post-meal sleepiness",
  "voice": "NARRATOR",
  "motion": "pull",
  "scene": "graphic",
  "image": "images/beat_044.png"
 },
 {
  "beat": 45,
  "start": 141.567,
  "dur": 2.917,
  "text": "and generally happens hours after a meal",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "graphic",
  "image": "images/beat_045.png"
 },
 {
  "beat": 46,
  "start": 144.484,
  "dur": 3.75,
  "text": "rather than a few minutes after you finish eating.",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "office",
  "image": "images/beat_046.png"
 },
 {
  "beat": 47,
  "start": 148.234,
  "dur": 3.75,
  "text": "So if your brain isn't being deprived of oxygen,",
  "voice": "NARRATOR",
  "motion": "pan",
  "scene": "body",
  "image": "images/beat_047.png"
 },
 {
  "beat": 48,
  "start": 151.984,
  "dur": 2.917,
  "text": "and your blood sugar hasn't necessarily crashed,",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "graphic",
  "image": "images/beat_048.png"
 },
 {
  "beat": 49,
  "start": 154.901,
  "dur": 2.083,
  "text": "what's making you so sleepy?",
  "voice": "NARRATOR",
  "motion": "pull",
  "scene": "office",
  "image": "images/beat_049.png"
 },
 {
  "beat": 50,
  "start": 156.984,
  "dur": 3.333,
  "text": "Okay, let's follow your lunch for a moment.",
  "voice": "NARRATOR",
  "motion": "fade",
  "scene": "cafe",
  "image": "images/beat_050.png"
 },
 {
  "beat": 51,
  "start": 160.317,
  "dur": 1.667,
  "text": "You've just finished eating.",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "cafe",
  "image": "images/beat_051.png"
 },
 {
  "beat": 52,
  "start": 161.984,
  "dur": 2.917,
  "text": "The food travels down into your stomach,",
  "voice": "NARRATOR",
  "motion": "pan",
  "scene": "body",
  "image": "images/beat_052.png"
 },
 {
  "beat": 53,
  "start": 164.901,
  "dur": 4.583,
  "text": "and as your stomach fills up, its walls begin to stretch.",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "body",
  "image": "images/beat_053.png"
 },
 {
  "beat": 54,
  "start": 169.484,
  "dur": 3.75,
  "text": "Now, your stomach doesn't just sit there holding food.",
  "voice": "NARRATOR",
  "motion": "pull",
  "scene": "body",
  "image": "images/beat_054.png"
 },
 {
  "beat": 55,
  "start": 173.234,
  "dur": 2.917,
  "text": "It starts sending messages to your brain.",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "body",
  "image": "images/beat_055.png"
 },
 {
  "beat": 56,
  "start": 176.151,
  "dur": 1.25,
  "text": "Basically telling it,",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "body",
  "image": "images/beat_056.png"
 },
 {
  "beat": 57,
  "start": 177.401,
  "dur": 3.75,
  "text": "\"Hey, food has arrived, we've got work to do.\"",
  "voice": "STOMACH",
  "motion": "pan",
  "scene": "body",
  "image": "images/beat_057.png"
 },
 {
  "beat": 58,
  "start": 181.151,
  "dur": 4.583,
  "text": "And as that food moves into your intestines, more messages follow.",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "body",
  "image": "images/beat_058.png"
 },
 {
  "beat": 59,
  "start": 185.734,
  "dur": 4.167,
  "text": "Your intestines begin breaking down the food further, absorbing nutrients,",
  "voice": "NARRATOR",
  "motion": "pull",
  "scene": "body",
  "image": "images/beat_059.png"
 },
 {
  "beat": 60,
  "start": 189.901,
  "dur": 4.167,
  "text": "and releasing chemical messengers that help control digestion and appetite.",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "body",
  "image": "images/beat_060.png"
 },
 {
  "beat": 61,
  "start": 194.068,
  "dur": 5.0,
  "text": "But what does any of this have to do with feeling sleepy?",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "office",
  "image": "images/beat_061.png"
 },
 {
  "beat": 62,
  "start": 199.068,
  "dur": 2.917,
  "text": "Well, your brain doesn't just control hunger.",
  "voice": "NARRATOR",
  "motion": "pan",
  "scene": "brainhq",
  "image": "images/beat_062.png"
 },
 {
  "beat": 63,
  "start": 201.985,
  "dur": 3.75,
  "text": "It also controls how awake and alert you feel.",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "brainhq",
  "image": "images/beat_063.png"
 },
 {
  "beat": 64,
  "start": 205.735,
  "dur": 3.333,
  "text": "After eating, the messages coming from your gut,",
  "voice": "NARRATOR",
  "motion": "pull",
  "scene": "brainhq",
  "image": "images/beat_064.png"
 },
 {
  "beat": 65,
  "start": 209.068,
  "dur": 3.333,
  "text": "along with changes in nutrients in your blood,",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "blood",
  "image": "images/beat_065.png"
 },
 {
  "beat": 66,
  "start": 212.401,
  "dur": 4.583,
  "text": "can influence the parts of your brain that keep you awake.",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "brainhq",
  "image": "images/beat_066.png"
 },
 {
  "beat": 67,
  "start": 216.984,
  "dur": 4.583,
  "text": "Scientists are still studying exactly how these different signals work together.",
  "voice": "NARRATOR",
  "motion": "pan",
  "scene": "lab",
  "image": "images/beat_067.png"
 },
 {
  "beat": 68,
  "start": 221.567,
  "dur": 2.083,
  "text": "There's no single sleep button",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "brainhq",
  "image": "images/beat_068.png"
 },
 {
  "beat": 69,
  "start": 223.65,
  "dur": 3.333,
  "text": "that your stomach presses every time you eat.",
  "voice": "NARRATOR",
  "motion": "pull",
  "scene": "body",
  "image": "images/beat_069.png"
 },
 {
  "beat": 70,
  "start": 226.983,
  "dur": 3.75,
  "text": "And these responses don't affect everyone the same way.",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "office",
  "image": "images/beat_070.png"
 },
 {
  "beat": 71,
  "start": 230.733,
  "dur": 4.583,
  "text": "You could eat the exact same meal for breakfast and lunch,",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "graphic",
  "image": "images/beat_071.png"
 },
 {
  "beat": 72,
  "start": 235.316,
  "dur": 2.5,
  "text": "yet feel much sleepier after lunch.",
  "voice": "NARRATOR",
  "motion": "pan",
  "scene": "office",
  "image": "images/beat_072.png"
 },
 {
  "beat": 73,
  "start": 237.816,
  "dur": 1.2,
  "text": "Why?",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "office",
  "image": "images/beat_073.png"
 },
 {
  "beat": 74,
  "start": 239.016,
  "dur": 3.75,
  "text": "Because sometimes, it's not just about what you eat.",
  "voice": "NARRATOR",
  "motion": "pull",
  "scene": "cafe",
  "image": "images/beat_074.png"
 },
 {
  "beat": 75,
  "start": 242.766,
  "dur": 2.083,
  "text": "It's about when you eat.",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "office",
  "image": "images/beat_075.png"
 },
 {
  "beat": 76,
  "start": 244.849,
  "dur": 2.083,
  "text": "Think about your usual day.",
  "voice": "NARRATOR",
  "motion": "fade",
  "scene": "graphic",
  "image": "images/beat_076.png"
 },
 {
  "beat": 77,
  "start": 246.932,
  "dur": 2.5,
  "text": "You wake up and eat breakfast",
  "voice": "NARRATOR",
  "motion": "pan",
  "scene": "breakfast",
  "image": "images/beat_077.png"
 },
 {
  "beat": 78,
  "start": 249.432,
  "dur": 3.333,
  "text": "and you most likely feel perfectly fine afterward.",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "breakfast",
  "image": "images/beat_078.png"
 },
 {
  "beat": 79,
  "start": 252.765,
  "dur": 1.667,
  "text": "Then you have lunch,",
  "voice": "NARRATOR",
  "motion": "pull",
  "scene": "cafe",
  "image": "images/beat_079.png"
 },
 {
  "beat": 80,
  "start": 254.432,
  "dur": 5.417,
  "text": "and suddenly, you're fighting for your life to stay awake at your desk.",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "office",
  "image": "images/beat_080.png"
 },
 {
  "beat": 81,
  "start": 259.849,
  "dur": 1.2,
  "text": "Why?",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "office",
  "image": "images/beat_081.png"
 },
 {
  "beat": 82,
  "start": 261.049,
  "dur": 3.333,
  "text": "Because your body has its own internal clock.",
  "voice": "NARRATOR",
  "motion": "pan",
  "scene": "body",
  "image": "images/beat_082.png"
 },
 {
  "beat": 83,
  "start": 264.382,
  "dur": 2.083,
  "text": "It's called your circadian rhythm.",
  "voice": "NARRATOR",
  "motion": "push",
  "scene": "clockgfx",
  "image": "images/beat_083.png"
 },
 {
  "beat": 84,
  "start": 266.465,
  "dur": 3.333,
  "text": "This clock helps regulate when you feel awake,",
  "voice": "NARRATOR",
  "motion": "pull",
  "scene": "clockgfx",
  "image": "images/beat_084.png"
 },
 {
  "beat": 85,
  "start": 269.798,
  "dur": 4.583,
  "text": "when you become tired, and when your body prepares for sleep.",
